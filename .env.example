# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env
#
# DimOS also reads .env from the DimOS checkout (sibling folder):
#   ../DimOS/.env

# Pi LAN IP (Quest browser + Connect API). Example only — replace with yours.
# Find it with:  hostname -I | awk '{print $1}'
QUEST_HOST_IP=192.168.1.100
DIMOS_TELEOP_HOST=192.168.1.100
DIMOS_TELEOP_PORT=8443
DIMOS_CONNECT_API_HOST=0.0.0.0
DIMOS_CONNECT_API_PORT=8450

# Path to the DimOS checkout (sibling folder by default)
DIMOS_ROOT=../DimOS

# CAN: right = can0, left = can1 (Peak CAN-FD 1M/5M — never classic 1M)
LEFT_CAN_PORT=can1
RIGHT_CAN_PORT=can0

DISPLAY=:0

# Optional LLM / Hugging Face (leave blank or use your-key-here)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ALIBABA_API_KEY=
HF_TOKEN=
HUGGINGFACE_ACCESS_TOKEN=
HUGGINGFACE_PRV_ENDPOINT=

# Optional hosted dimTELE broker (https://teleop.dimensionalos.com)
TRANSPORTS__BROKER__BROKER_URL=https://teleop.dimensionalos.com
TRANSPORTS__BROKER__API_KEY=
TRANSPORTS__BROKER__ROBOT_ID=
TRANSPORTS__BROKER__ROBOT_NAME=

WEBRTC_SERVER_HOST=0.0.0.0
WEBRTC_SERVER_PORT=9991
ROBOT_IP=
CONN_TYPE=webrtc
TEST_RTSP_URL=

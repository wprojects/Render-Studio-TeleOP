+    def _enable_motors_without_gripper_calibration(self) -> None:
+        """Enable in place, then select gripper mode and apply the start opening."""
+        for arm in self._arms.values():
+            arm.enable_all()
+        for gripper in self._grippers.values():
+            gripper.set_mode(self.gripper_control_mode)
+            gripper.enable()
+        self._refresh()
+        if self.activation_gripper_opening is None:
+            self._hold_current_gripper_positions()
+        else:
+            for name in self.gripper_joints:
+                self._write_gripper_opening(name, self.activation_gripper_opening)
+            self._robot.tick(self._runtime_config.tick_deadline_us)
+
+    def _hold_current_gripper_positions(self) -> None:
+        held = False
+        for gripper in self._grippers.values():
+            pos_force = getattr(gripper, "pos_force_control", None)
+            motor = getattr(gripper, "motor", None)
+            if pos_force is None or motor is None:
+                continue
+            pos_force(float(motor.position), 0.0, self.gripper_command_current)
+            held = True
+        if held:
+            self._robot.tick(self._runtime_config.tick_deadline_us)
+
+    def _read_gripper_opening(self, name: str) -> float:
+        gripper = self._grippers[name]
+        if not self.calibrate_grippers_on_enable:
+            mapped = self._opening_from_motor_position(name)
+            if mapped is not None:
+                return mapped
+        try:
+            opening = float(gripper.opening)
+        except Exception:
+            opening = float("nan")
+        if np.isfinite(opening) and 0.0 <= opening <= 1.0:
+            return opening
+        mapped = self._opening_from_motor_position(name)
+        if mapped is not None:
+            return mapped
+        raise RuntimeError(f"gripper {name!r} returned invalid opening {opening}")
+
+    def _write_gripper_opening(self, name: str, opening: float) -> None:
+        gripper = self._grippers[name]
+        motor_q = self._motor_position_for_opening(name, opening)
+        if motor_q is not None and self.gripper_control_mode == "mit":
+            gripper.mit_control(self.gripper_mit_kp, self.gripper_mit_kd, motor_q, 0.0, 0.0)
+            return
+        pos_force = getattr(gripper, "pos_force_control", None)
+        if motor_q is not None and pos_force is not None:
+            pos_force(motor_q, self.gripper_command_velocity_rad_s, self.gripper_command_current)
+            return
+        gripper.set_opening(opening)
+
+    def _motor_position_for_opening(self, name: str, opening: float) -> float | None:
+        del name, opening
+        return None
+
+    def _opening_from_motor_position(self, name: str) -> float | None:
+        gripper = self._grippers[name]
+        motor = getattr(gripper, "motor", None)
+        closed_q = self._motor_position_for_opening(name, 0.0)
+        open_q = self._motor_position_for_opening(name, 1.0)
+        if motor is None or closed_q is None or open_q is None or closed_q == open_q:
+            return None
+        opening = (float(motor.position) - closed_q) / (open_q - closed_q)
+        return float(np.clip(opening, 0.0, 1.0))
+
     def _refresh(self) -> None:
         self._robot.refresh()
         self._robot.tick(self._runtime_config.tick_deadline_us)

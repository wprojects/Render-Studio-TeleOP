+        self.episode_review.observe_automatic_result(result, confidence=confidence, reason=reason)
+        self._update_episode_review_ui()
+
+    def _update_episode_review_ui(self) -> None:
+        record = self.episode_review.record
+        gates_passed = sum(value is True for value in record.readiness_gates.values())
+        gates_total = len(record.readiness_gates)
+        self._set_handle_value(
+            "episode_status",
+            "### Episode evaluation\n\n"
+            f"**Phase:** `{record.phase.value}`  \n"
+            f"**Run:** `{record.run_id or 'not assigned'}`  \n"
+            f"**Policy:** `{record.policy or 'not selected'}`  \n"
+            f"**Readiness:** `{gates_passed}/{gates_total} passed`",
+        )
+        readiness = record.phase == EpisodePhase.READINESS
+        for gate in DEFAULT_READINESS_GATES:
+            self._set_disabled(f"episode_gate:{gate}", not readiness)
+        self._set_disabled("episode_prepare", record.phase != EpisodePhase.IDLE)
+        all_gates_passed = bool(record.readiness_gates) and all(
+            value is True for value in record.readiness_gates.values()
+        )
+        self._set_disabled("episode_started", not readiness or not all_gates_passed)
+        self._set_disabled("episode_stopped", record.phase != EpisodePhase.RUNNING)
+        camera_lines = ["### Camera health"]
+        if not record.camera_health:
+            camera_lines.append("No camera telemetry has been published.")
+        for name, camera in sorted(record.camera_health.items()):
+            camera_lines.append(f"- **{name}:** `{camera.status.value}` — {camera.detail}")
+            self._set_handle_value(
+                f"episode_camera:{name}",
+                f"**Health:** `{camera.status.value}`  \n{camera.detail}\n\nImage/frustum stream placeholder",
+            )
+        self._set_handle_value("episode_cameras", "\n\n".join(camera_lines))
+        confidence = (
+            "not reported"
+            if record.automatic_confidence is None
+            else f"{record.automatic_confidence:.0%}"
+        )
+        self._set_handle_value(
+            "episode_review_summary",
+            "### Episode review\n\n"
+            f"**Automatic result:** `{record.automatic_result or 'pending'}`  \n"
+            f"**Confidence:** `{confidence}`  \n"
+            f"**Reason:** {record.automatic_reason or 'Not reported'}  \n"
+            f"**Operator label:** `{record.operator_label.value if record.operator_label else 'pending'}`",
+        )
+        reviewing = record.phase == EpisodePhase.REVIEW
+        self._set_disabled("episode_failure_reason", not reviewing)
+        self._set_disabled("episode_note", not reviewing)
+        for label in OperatorLabel:
+            self._set_disabled(f"episode_label:{label.value}", not reviewing)
+        self._set_disabled("episode_finalize", record.phase != EpisodePhase.LABELED)
+        self._set_disabled("episode_reset", record.phase != EpisodePhase.RESET_REQUIRED)
+        event_lines = ["### Bounded event log"]
+        event_lines.extend(
+            f"`{event.timestamp}` **{event.category}** — {event.message}" for event in record.events
+        )
+        if not record.events:
+            event_lines.append("No events recorded.")
+        self._set_handle_value("episode_diagnostics", "\n\n".join(event_lines))
+        self._refresh_episode_export()
+
+    def _refresh_episode_export(self) -> None:
+        self._set_handle_value("episode_export", self.episode_review.export_json())
+
+    def _handle_value(self, key: str) -> Any:
+        handle = self._handles.get(key)
+        return "" if handle is None else getattr(handle, "value", "")
 

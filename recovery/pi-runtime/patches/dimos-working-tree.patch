 class CollectionRecorder(Recorder):
-    """Records the streams DataPrep consumes from a teleop session."""
+    """Records synchronized-capable imitation-learning source streams.
+
+    Streams retain their source timestamp independently. DataPrep performs the
+    fixed-rate nearest-sample alignment when exporting LeRobot, avoiding a
+    lossy second live recorder and preserving evidence about camera/joint skew.
+    """
 
     config: CollectionRecorderConfig
 
+    # Legacy single-camera name retained for existing XArm/Piper blueprints.
     color_image: In[Image]  # observation (camera)
-    coordinator_joint_state: In[JointState]  # observation + action (measured/next state)
+    # OpenArm observation/action contract.
+    left_commanded_action: In[PoseStamped]
+    right_commanded_action: In[PoseStamped]
+    coordinator_joint_state: In[JointState]  # measured left + right + grippers
+    left_gripper_command: In[Float32]
+    right_gripper_command: In[Float32]
+    left_wrist_image: In[Image]
+    right_wrist_image: In[Image]
+    top_camera_image: In[Image]
     status: In[EpisodeStatus]  # episode start/save/discard segmentation
 
+    def __init__(self, *args: Any, **kwargs: Any) -> None:
+        super().__init__(*args, **kwargs)
+        self._capture_lock = threading.Lock()
+        self._capture_counts: dict[str, int] = {}
+        self._capture_last_source_ts: dict[str, float] = {}
+        self._capture_last_reception_ts: dict[str, float] = {}
+
+    def _on_recorded(self, name: str, msg: Any, ts: float, reception_ts: float) -> None:
+        with self._capture_lock:
+            self._capture_counts[name] = self._capture_counts.get(name, 0) + 1
+            self._capture_last_source_ts[name] = ts
+            self._capture_last_reception_ts[name] = reception_ts
+
+    @rpc
+    def capture_status(self) -> dict[str, Any]:
+        """Live proof that every required stream is connected and advancing."""
+        now = time.time()
+        with self._capture_lock:
+            rows = {
+                name: {
+                    "count": self._capture_counts.get(name, 0),
+                    "source_age_ms": (
+                        round(max(0.0, now - self._capture_last_source_ts[name]) * 1000.0, 1)
+                        if name in self._capture_last_source_ts
+                        else None
+                    ),
+                    "reception_age_ms": (
+                        round(max(0.0, now - self._capture_last_reception_ts[name]) * 1000.0, 1)
+                        if name in self._capture_last_reception_ts
+                        else None
+                    ),
+                    "connected": getattr(self.inputs[name], "_transport", None) is not None,
+                }
+                for name in REQUIRED_OPENARM_STREAMS
+            }
+        advancing = all(
+            row["count"] > 0 and (row["reception_age_ms"] or 0) < 2000 for row in rows.values()
+        )
+        camera_source_ts = [
+            self._capture_last_source_ts[name]
+            for name in ("left_wrist_image", "right_wrist_image", "top_camera_image")
+            if name in self._capture_last_source_ts
+        ]
+        return {
+            "ok": True,
+            "recording_path": str(self.config.db_path),
+            "all_required_advancing": advancing,
+            "camera_skew_ms": (
+                round((max(camera_source_ts) - min(camera_source_ts)) * 1000.0, 1)
+                if len(camera_source_ts) == 3
+                else None
+            ),
+            "streams": rows,
+        }
+

+#     http://www.apache.org/licenses/LICENSE-2.0
+
+from __future__ import annotations
+
+from collections import deque
+from collections.abc import Callable
+from dataclasses import asdict, dataclass, field
+from datetime import datetime, timezone
+from enum import Enum
+import json
+from typing import Any
+
+
+class EpisodePhase(str, Enum):
+    IDLE = "idle"
+    READINESS = "readiness"
+    RUNNING = "running"
+    REVIEW = "review"
+    LABELED = "labeled"
+    RESET_REQUIRED = "reset_required"
+
+
+class OperatorLabel(str, Enum):
+    PASS = "pass"
+    FAIL = "fail"
+    UNCERTAIN = "uncertain"
+    EXCLUDE = "exclude"
+
+
+class CameraStatus(str, Enum):
+    UNKNOWN = "unknown"
+    HEALTHY = "healthy"
+    DEGRADED = "degraded"
+    OFFLINE = "offline"
+
+
+DEFAULT_READINESS_GATES = (
+    "robot_connected",
+    "emergency_stop_ready",
+    "workspace_clear",
+    "cameras_online",
+    "policy_loaded",
+)
+
+
+@dataclass(frozen=True)
+class EpisodeEvent:
+    timestamp: str
+    category: str
+    message: str
+
+
+@dataclass(frozen=True)
+class CameraHealth:
+    status: CameraStatus = CameraStatus.UNKNOWN
+    detail: str = "No health report"
+
+
+@dataclass
+class EpisodeReviewRecord:
+    phase: EpisodePhase = EpisodePhase.IDLE
+    run_id: str = ""
+    policy: str = ""
+    readiness_gates: dict[str, bool | None] = field(
+        default_factory=lambda: {name: None for name in DEFAULT_READINESS_GATES}
+    )
+    camera_health: dict[str, CameraHealth] = field(default_factory=dict)
+    automatic_result: str = ""
+    automatic_confidence: float | None = None
+    automatic_reason: str = ""
+    operator_label: OperatorLabel | None = None
+    failure_reason: str = ""
+    operator_note: str = ""
+    created_at: str = ""
+    started_at: str = ""
+    completed_at: str = ""
+    labeled_at: str = ""
+    events: deque[EpisodeEvent] = field(default_factory=lambda: deque(maxlen=120))
+
+
+class EpisodeReviewStateMachine:
+    """Authoritative, bounded operator-review record for one robot episode.
+
+    The state machine records observations and labels only. It has no robot-command
+    callback and therefore cannot start, stop, or otherwise actuate hardware.
+    """
+
+    def __init__(
+        self,
+        *,
+        now: Callable[[], datetime] | None = None,
+        event_limit: int = 120,
+    ) -> None:
+        if event_limit < 1:
+            raise ValueError("event_limit must be positive")
+        self._now = now or (lambda: datetime.now(timezone.utc))
+        self._event_limit = event_limit
+        self.record = self._new_record()
+
+    def begin_readiness(self, run_id: str, policy: str) -> None:
+        if self.record.phase != EpisodePhase.IDLE:
+            raise ValueError(f"Cannot begin readiness from {self.record.phase.value}")
+        self.record = self._new_record()
+        self.record.phase = EpisodePhase.READINESS
+        self.record.run_id = self._bounded(run_id, 120)
+        self.record.policy = self._bounded(policy, 240)
+        self._add_event("run", f"Readiness opened for {self.record.run_id or 'unassigned run'}")
+
+    def set_readiness_gate(self, name: str, passed: bool | None) -> None:
+        if self.record.phase != EpisodePhase.READINESS:
+            raise ValueError("Readiness gates can only change during readiness")
+        gate = self._bounded(name, 80)
+        self.record.readiness_gates[gate] = passed
+        value = "pending" if passed is None else "pass" if passed else "fail"
+        self._add_event("readiness", f"{gate}: {value}")
+
+    def observe_running(self) -> None:
+        if self.record.phase != EpisodePhase.READINESS:
+            raise ValueError("A run can only be observed after readiness")
+        incomplete = [
+            name for name, passed in self.record.readiness_gates.items() if passed is not True
+        ]
+        if incomplete:
+            raise ValueError(f"Readiness gates are not all passed: {', '.join(incomplete)}")
+        self.record.phase = EpisodePhase.RUNNING
+        self.record.started_at = self._timestamp()
+        self._add_event("run", "Run observed as started")
+
+    def observe_automatic_result(
+        self,
+        result: str,
+        *,
+        confidence: float | None = None,
+        reason: str = "",
+    ) -> None:
+        if self.record.phase != EpisodePhase.RUNNING:
+            raise ValueError("An automatic result requires a running episode")
+        if confidence is not None and not 0.0 <= confidence <= 1.0:
+            raise ValueError("confidence must be between 0 and 1")
+        self.record.phase = EpisodePhase.REVIEW
+        self.record.automatic_result = self._bounded(result, 80)
+        self.record.automatic_confidence = confidence
+        self.record.automatic_reason = self._bounded(reason, 500)
+        self.record.completed_at = self._timestamp()
+        self._add_event("result", f"Automatic result: {self.record.automatic_result or 'unknown'}")
+
+    def label(
+        self,
+        label: OperatorLabel,
+        *,
+        failure_reason: str = "",
+        note: str = "",
+    ) -> None:
+        if self.record.phase != EpisodePhase.REVIEW:
+            raise ValueError("Operator labels are only accepted during review")
+        if label == OperatorLabel.FAIL and not failure_reason.strip():
+            raise ValueError("A failure reason is required for FAIL")
+        self.record.phase = EpisodePhase.LABELED
+        self.record.operator_label = label
+        self.record.failure_reason = self._bounded(failure_reason, 160)
+        self.record.operator_note = self._bounded(note, 1000)
+        self.record.labeled_at = self._timestamp()
+        self._add_event("label", f"Operator label: {label.value}")
+
+    def require_reset(self) -> None:
+        if self.record.phase != EpisodePhase.LABELED:
+            raise ValueError("Only a labeled episode can require reset")
+        self.record.phase = EpisodePhase.RESET_REQUIRED
+        self._add_event("run", "Episode finalized; reset required")
+
+    def reset(self) -> None:
+        if self.record.phase != EpisodePhase.RESET_REQUIRED:
+            raise ValueError("Reset is only allowed after finalization")
+        self.record = self._new_record()
+
+    def update_camera(self, name: str, status: CameraStatus, detail: str = "") -> None:
+        camera_name = self._bounded(name, 80)
+        camera = CameraHealth(status, self._bounded(detail, 240) or "No detail")
+        self.record.camera_health[camera_name] = camera
+        self._add_event("camera", f"{camera_name}: {status.value}")
+
+    def add_observation(self, category: str, message: str) -> None:
+        self._add_event(self._bounded(category, 40), self._bounded(message, 500))
+
+    def export_json(self) -> str:
+        payload = asdict(self.record)
+        payload["phase"] = self.record.phase.value
+        payload["operator_label"] = (
+            None if self.record.operator_label is None else self.record.operator_label.value
+        )
+        payload["camera_health"] = {
+            name: {"status": camera.status.value, "detail": camera.detail}
+            for name, camera in self.record.camera_health.items()
+        }
+        payload["events"] = [asdict(event) for event in self.record.events]
+        return json.dumps(payload, indent=2, sort_keys=True)
+
+    def _new_record(self) -> EpisodeReviewRecord:
+        return EpisodeReviewRecord(
+            created_at=self._timestamp(), events=deque(maxlen=self._event_limit)
+        )
+
+    def _add_event(self, category: str, message: str) -> None:
+        self.record.events.append(EpisodeEvent(self._timestamp(), category, message))
+
+    def _timestamp(self) -> str:
+        value = self._now()
+        if value.tzinfo is None:
+            value = value.replace(tzinfo=timezone.utc)
+        return value.astimezone(timezone.utc).isoformat()
+
+    @staticmethod
+    def _bounded(value: Any, limit: int) -> str:
+        return str(value).strip()[:limit]

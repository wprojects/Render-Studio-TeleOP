+PCAN_USB_PRO_FD_VENDOR_ID = 0x0C72
+PCAN_USB_PRO_FD_PRODUCT_ID = 0x0011
+PCAN_USB_PRO_FD_NAME = "PEAK-System PCAN-USB Pro FD"
+# Dual-channel Pro FD. These are PCANBasic/MacCAN names, not gs_usb serials.
+PCAN_USB_PRO_FD_CHANNELS = ("PCAN_USBBUS1", "PCAN_USBBUS2")
+
+
+class _PcanUsbProFd(NamedTuple):
+    name: str
+    vendor_id: int
+    product_id: int
+    serial_number: str | None
+
+
+def _usb_int(value: object) -> int | None:
+    if isinstance(value, bool) or value is None:
+        return None
+    if isinstance(value, int):
+        return value
+    if isinstance(value, str):
+        text = value.strip().split()[0]
+        try:
+            return int(text, 0)
+        except ValueError:
+            return None
+    return None
+
+
+def _iter_ioreg_dicts(node: object) -> Iterator[dict[str, Any]]:
+    if isinstance(node, dict):
+        yield node
+        for value in node.values():
+            yield from _iter_ioreg_dicts(value)
+    elif isinstance(node, list):
+        for value in node:
+            yield from _iter_ioreg_dicts(value)
+
+
+def pcan_usb_pro_fd_from_ioreg(node: object) -> tuple[_PcanUsbProFd, ...]:
+    """Return PCAN-USB Pro FD devices present in an ioreg IOUSB plist."""
+    found: list[_PcanUsbProFd] = []
+    seen: set[tuple[object, str | None]] = set()
+    for entry in _iter_ioreg_dicts(node):
+        vendor_id = _usb_int(entry.get("idVendor") or entry.get("kUSBVendorID"))
+        product_id = _usb_int(entry.get("idProduct") or entry.get("kUSBProductID"))
+        if vendor_id != PCAN_USB_PRO_FD_VENDOR_ID or product_id != PCAN_USB_PRO_FD_PRODUCT_ID:
+            continue
+        serial = entry.get("USB Serial Number") or entry.get("kUSBSerialNumberString")
+        serial_number = serial.strip() if isinstance(serial, str) and serial.strip() else None
+        identity = (entry.get("locationID"), serial_number)
+        if identity in seen:
+            continue
+        seen.add(identity)
+        found.append(
+            _PcanUsbProFd(
+                name=PCAN_USB_PRO_FD_NAME,
+                vendor_id=vendor_id,
+                product_id=product_id,
+                serial_number=serial_number,
+            )
+        )
+    return tuple(found)
+
+
+def _list_pcan_usb_pro_fd() -> tuple[_PcanUsbProFd, ...]:
+    """List PEAK PCAN-USB Pro FD adapters from the macOS USB registry."""
+    try:
+        result = subprocess.run(
+            ["ioreg", "-p", "IOUSB", "-l", "-a", "-w", "0"],
+            check=False,
+            capture_output=True,
+            timeout=10,
+        )
+    except (FileNotFoundError, subprocess.TimeoutExpired):
+        return ()
+    if result.returncode != 0 or not result.stdout:
+        return ()
+    try:
+        tree = plistlib.loads(result.stdout)
+    except (plistlib.InvalidFileException, ValueError):
+        return ()
+    return pcan_usb_pro_fd_from_ioreg(tree)
+
+
+def _echo_pcan_usb_pro_fd(devices: tuple[_PcanUsbProFd, ...]) -> None:
+    typer.echo("NAME                           USB ID     SERIAL     CHANNEL")
+    for device in devices:
+        usb_id = f"{device.vendor_id:04X}:{device.product_id:04X}"
+        serial = device.serial_number or "<missing>"
+        for channel in PCAN_USB_PRO_FD_CHANNELS:
+            typer.echo(f"{device.name:<30} {usb_id:<10} {serial:<10} {channel}")
+    typer.echo(
+        "OpenArm cannot open PEAK PCAN-USB on macOS yet. "
+        "--left-can-port/--right-can-port still need gs_usb serials, or Linux can0/can1 "
+        "after peak_usb. See docs/capabilities/manipulation/openarm_integration.md.",
+        err=True,
+    )
 
 

+from datetime import datetime, timedelta, timezone
+import json
+
+import pytest
+
+from dimos.manipulation.visualization.viser.episode_review import (
+    CameraStatus,
+    EpisodePhase,
+    EpisodeReviewStateMachine,
+    OperatorLabel,
+)
+
+
+class Clock:
+    def __init__(self) -> None:
+        self._value = datetime(2026, 9, 29, tzinfo=timezone.utc)
+
+    def __call__(self) -> datetime:
+        value = self._value
+        self._value += timedelta(seconds=1)
+        return value
+
+
+def test_episode_review_captures_run_evidence_and_operator_label() -> None:
+    review = EpisodeReviewStateMachine(now=Clock())
+
+    review.begin_readiness("run-42", "openarm/pick-cup")
+    for gate in review.record.readiness_gates:
+        review.set_readiness_gate(gate, True)
+    review.update_camera("wrist", CameraStatus.HEALTHY, "30 fps")
+    review.observe_running()
+    review.observe_automatic_result(
+        "task_complete", confidence=0.91, reason="Object reached goal region"
+    )
+    review.label(OperatorLabel.PASS, note="Clean placement")
+
+    assert review.record.phase == EpisodePhase.LABELED
+    assert review.record.run_id == "run-42"
+    assert review.record.policy == "openarm/pick-cup"
+    assert review.record.camera_health["wrist"].status == CameraStatus.HEALTHY
+    assert review.record.automatic_confidence == 0.91
+    assert review.record.operator_label == OperatorLabel.PASS
+    assert review.record.started_at < review.record.completed_at < review.record.labeled_at
+
+
+def test_fail_requires_taxonomy_reason_and_only_review_accepts_labels() -> None:
+    review = EpisodeReviewStateMachine(now=Clock())
+
+    with pytest.raises(ValueError, match="only accepted during review"):
+        review.label(OperatorLabel.PASS)
+
+    review.begin_readiness("run-1", "policy")
+    for gate in review.record.readiness_gates:
+        review.set_readiness_gate(gate, True)
+    review.observe_running()
+    review.observe_automatic_result("failed")
+
+    with pytest.raises(ValueError, match="failure reason is required"):
+        review.label(OperatorLabel.FAIL)
+
+    review.label(OperatorLabel.FAIL, failure_reason="Grasp / contact")
+    assert review.record.failure_reason == "Grasp / contact"
+
+
+def test_finalize_and_reset_preserve_labeled_record_until_operator_reset() -> None:
+    review = EpisodeReviewStateMachine(now=Clock())
+    review.begin_readiness("run-1", "policy")
+    for gate in review.record.readiness_gates:
+        review.set_readiness_gate(gate, True)
+    review.observe_running()
+    review.observe_automatic_result("unknown")
+    review.label(OperatorLabel.UNCERTAIN)
+
+    review.require_reset()
+
+    assert review.record.phase == EpisodePhase.RESET_REQUIRED
+    assert review.record.operator_label == OperatorLabel.UNCERTAIN
+
+    review.reset()
+
+    assert review.record.phase == EpisodePhase.IDLE
+    assert review.record.run_id == ""
+
+
+def test_event_log_is_bounded_and_export_is_machine_readable() -> None:
+    review = EpisodeReviewStateMachine(now=Clock(), event_limit=3)
+    review.begin_readiness("run-1", "policy")
+
+    for index in range(5):
+        review.add_observation("button", f"clicked {index}")
+
+    payload = json.loads(review.export_json())
+
+    assert len(payload["events"]) == 3
+    assert [event["message"] for event in payload["events"]] == [
+        "clicked 2",
+        "clicked 3",
+        "clicked 4",
+    ]
+    assert payload["phase"] == "readiness"
+
+
+def test_running_requires_every_readiness_gate_and_finalized_record_cannot_be_replaced() -> None:
+    review = EpisodeReviewStateMachine(now=Clock())
+    review.begin_readiness("run-1", "policy")
+
+    with pytest.raises(ValueError, match="Readiness gates are not all passed"):
+        review.observe_running()
+
+    for gate in review.record.readiness_gates:
+        review.set_readiness_gate(gate, True)
+    review.observe_running()
+    review.observe_automatic_result("complete")
+    review.label(OperatorLabel.PASS)
+    review.require_reset()
+
+    with pytest.raises(ValueError, match="Cannot begin readiness from reset_required"):
+        review.begin_readiness("run-2", "policy")

diff --git a/dimos/hardware/whole_body/damiao/adapter.py b/dimos/hardware/whole_body/damiao/adapter.py
--- a/dimos/hardware/whole_body/damiao/adapter.py
+++ b/dimos/hardware/whole_body/damiao/adapter.py
@@ -52,6 +52,7 @@ class DamiaoWholeBodyAdapter(ABC):
     # Robot.enable() runs a full-open then full-close gripper calibration
     # sweep. OpenArm skips that slam and enables motors in place.
     calibrate_grippers_on_enable = True
+    activation_gripper_opening: float | None = None
     gripper_control_mode = "pos_force"
     gripper_command_current = 0.15
     gripper_command_velocity_rad_s = 0.0
@@ -402,4 +403,9 @@ class DamiaoWholeBodyAdapter(ABC):
         self._refresh()
-        self._hold_current_gripper_positions()
+        if self.activation_gripper_opening is None:
+            self._hold_current_gripper_positions()
+        else:
+            for name in self.gripper_joints:
+                self._write_gripper_opening(name, self.activation_gripper_opening)
+            self._robot.tick(self._runtime_config.tick_deadline_us)
 
     def _hold_current_gripper_positions(self) -> None:
diff --git a/dimos/hardware/whole_body/openarm_damiao/adapter.py b/dimos/hardware/whole_body/openarm_damiao/adapter.py
--- a/dimos/hardware/whole_body/openarm_damiao/adapter.py
+++ b/dimos/hardware/whole_body/openarm_damiao/adapter.py
@@ -26,6 +26,7 @@ from dimos.robot.manipulators.openarm.config import (
     OPENARM_GRIPPER_CLOSED_POSITION_RAD,
     OPENARM_GRIPPER_CURRENT,
     OPENARM_GRIPPER_OPENING_DIRECTION,
+    OPENARM_GRIPPER_REST_OPENING,
     OPENARM_GRIPPER_SPEED_RAD_S,
     OPENARM_GRIPPER_TRAVEL_RAD,
 )
@@ -69,6 +70,7 @@ class OpenArmDamiaoAdapter(DamiaoWholeBodyAdapter):
     bus_names = ("right", "left")
     kinematic_joint_names = (*arm_joints["left_arm"], *arm_joints["right_arm"])
     calibrate_grippers_on_enable = False
+    activation_gripper_opening = OPENARM_GRIPPER_REST_OPENING
     # The installed gripper firmware ignores POS_FORCE packets. Use the
     # firmware-compatible MIT position loop with conservative gains.
     gripper_control_mode = "mit"
